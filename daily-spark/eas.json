{
  "cli": {
    "version": ">= 8.0.0"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": false
      },
      "env": {
        "EXPO_PUBLIC_MAX_SPARKS_PER_DAY": "3",
        "EXPO_PUBLIC_DEDUP_WINDOW_DAYS": "90"
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_MAX_SPARKS_PER_DAY": "3",
        "EXPO_PUBLIC_DEDUP_WINDOW_DAYS": "90"
      }
    },
    "production": {
      "autoIncrement": true
    }
  },
  "submit": {
    "production": {}
  }
}
