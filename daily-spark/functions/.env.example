# ─── Firebase Cloud Functions Environment Variables ──────────────────────────
# Copy this to functions/.env (never committed — in .gitignore)
#
# PRODUCTION: Use Firebase Secrets Manager instead:
#   firebase functions:secrets:set OPENAI_API_KEY
# Then reference in function: runWith({ secrets: ['OPENAI_API_KEY'] })

# OpenAI API key (get from platform.openai.com/api-keys)
OPENAI_API_KEY=sk-...

# Model to use for spark generation (gpt-4o-mini is cost-effective)
OPENAI_MODEL=gpt-4o-mini

# Number of sparks to generate per topic per day (10 gives good variety)
SPARKS_PER_TOPIC_PER_DAY=10
