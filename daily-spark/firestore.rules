rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users can only read/write their own document
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Sparks are readable by any authenticated user (content is not PII)
    match /sparks/{sparkId} {
      allow read: if request.auth != null;
      allow write: if false; // Only Cloud Functions write sparks
    }

    // Feedback: users can create/read their own feedback
    match /feedback/{feedbackId} {
      allow read, create: if request.auth != null
        && feedbackId.matches(request.auth.uid + '_.*');
      allow update, delete: if false;
    }

    // Notification logs: users read their own
    match /notifications/{userId}/log/{logId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false; // Cloud Functions only
    }

    // Referrals:
    //   - Referrer can read & create their own doc (when generating a share link)
    //   - Any authenticated user can update any referral doc
    //     (needed when a new user records the referral for the referrer)
    //   TODO: Move recordReferral() to a Cloud Function callable for tighter security
    match /referrals/{referrerId} {
      allow read: if request.auth != null && request.auth.uid == referrerId;
      allow create: if request.auth != null && request.auth.uid == referrerId;
      allow update: if request.auth != null;
    }

    // Deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
